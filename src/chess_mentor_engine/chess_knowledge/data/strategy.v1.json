    {
      "id": "plan.blockade_passed_pawn",
      "kind": "plan",
      "preferred_name": "Blockade a Passed Pawn",
      "definition": "Restrain an opposing passed pawn by occupying or controlling its advance squares and reducing supporting activity.",
