      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.initiative",
      "kind": "evaluation_factor",
      "preferred_name": "Initiative Factor",
      "definition": "The degree to which one side can make threats or forcing improvements that compel the opponent to react.",
