      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.double_on_open_file",
      "kind": "plan",
      "preferred_name": "Double on an Open File",
      "definition": "Coordinate rooks on a useful open or semi-open file to increase pressure and penetration potential.",
