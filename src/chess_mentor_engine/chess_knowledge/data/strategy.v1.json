      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.passed_pawns",
      "kind": "evaluation_factor",
      "preferred_name": "Passed Pawn Factor",
      "definition": "The promotion potential, restraint burden, and activity effects created by passed pawns.",
