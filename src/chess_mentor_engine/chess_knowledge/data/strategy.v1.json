      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.space",
      "kind": "evaluation_factor",
      "preferred_name": "Space Factor",
      "definition": "The relative amount of territory in which a side can maneuver safely and restrict opposing piece mobility.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.center_control",
      "kind": "evaluation_factor",
      "preferred_name": "Center Control Factor",
      "definition": "The relative control, occupation, and challenge of strategically central squares and lines.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.pawn_structure",
      "kind": "evaluation_factor",
      "preferred_name": "Pawn Structure Factor",
      "definition": "The long-term strengths, weaknesses, mobility, and target profile created by each side's pawns.",
