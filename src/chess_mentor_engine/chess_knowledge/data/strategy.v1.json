      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.development",
      "kind": "evaluation_factor",
      "preferred_name": "Development Factor",
      "definition": "The relative deployment and readiness of pieces, especially in the opening and early middlegame.",
