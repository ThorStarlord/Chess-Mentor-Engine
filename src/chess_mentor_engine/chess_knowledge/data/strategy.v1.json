      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "group.plans",
      "kind": "concept_group",
      "preferred_name": "Strategic Plans",
      "definition": "Candidate long-horizon objectives that connect position features and principles to move selection without themselves claiming a best move.",
      "detection_support": "none",
      "default_assertion_authority": "heuristic_assessment"
    },
    {
      "id": "plan.attack_king",
      "kind": "plan",
      "preferred_name": "Attack the King",
      "definition": "Organize pieces, pawn breaks, or forcing moves toward exploiting a concrete king-safety weakness.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.improve_worst_piece",
      "kind": "plan",
      "preferred_name": "Improve the Worst Piece",
      "definition": "Improve the placement or role of the side's least effective piece when no forcing priority dominates.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.create_pawn_break",
      "kind": "plan",
      "preferred_name": "Create or Execute a Pawn Break",
      "definition": "Use a pawn advance to challenge a structure, open lines, or transform the center or wing.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.open_file",
      "kind": "plan",
      "preferred_name": "Open a File",
      "definition": "Exchange or advance pawns so a rook or queen can gain useful line access on a file.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.occupy_outpost",
      "kind": "plan",
      "preferred_name": "Occupy an Outpost",
      "definition": "Establish a piece on a stable advanced square that the opponent cannot readily challenge with pawns.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.exchange_key_defender",
      "kind": "plan",
      "preferred_name": "Exchange a Key Defender",
      "definition": "Remove or exchange a piece whose defensive role is central to the opponent's position.",
