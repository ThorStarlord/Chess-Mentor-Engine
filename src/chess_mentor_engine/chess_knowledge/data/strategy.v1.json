    {
      "id": "plan.penetrate_seventh_rank",
      "kind": "plan",
      "preferred_name": "Penetrate the Seventh Rank",
      "definition": "Enter the opponent's second rank with a rook or queen to attack pawns, restrict the king, or coordinate threats.",
