      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.weak_squares",
      "kind": "evaluation_factor",
      "preferred_name": "Weak Squares Factor",
      "definition": "Important squares that are difficult for one side to contest with pawns or pieces and that can be exploited by the opponent.",
