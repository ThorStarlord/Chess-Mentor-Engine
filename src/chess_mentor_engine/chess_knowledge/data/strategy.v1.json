      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.restrict_counterplay",
      "kind": "plan",
      "preferred_name": "Restrict Counterplay",
      "definition": "Reduce the opponent's active resources before converting an advantage or executing a longer-term plan.",
