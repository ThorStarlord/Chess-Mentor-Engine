      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.increase_piece_coordination",
      "kind": "plan",
      "preferred_name": "Increase Piece Coordination",
      "definition": "Improve how pieces support one another and combine toward shared defensive or offensive tasks.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    }
  ]
}
