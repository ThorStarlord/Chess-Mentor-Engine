      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.trade_into_endgame",
      "kind": "plan",
      "preferred_name": "Trade into a Favorable Endgame",
      "definition": "Seek simplification when the resulting endgame preserves or improves the side's practical or objective prospects.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.create_second_weakness",
      "kind": "plan",
      "preferred_name": "Create a Second Weakness",
      "definition": "Create another separated target so the defense must divide resources across more than one front.",
