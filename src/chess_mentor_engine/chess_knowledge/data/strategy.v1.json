      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.piece_activity",
      "kind": "evaluation_factor",
      "preferred_name": "Piece Activity Factor",
      "definition": "The extent to which pieces occupy useful squares, influence relevant targets, and participate effectively in play.",
      "detection_support": "heuristic",
      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.piece_coordination",
      "kind": "evaluation_factor",
      "preferred_name": "Piece Coordination Factor",
      "definition": "How effectively pieces support common objectives, defend one another, and avoid conflicting or redundant roles.",
