      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.evaluation_factors"]
    },
    {
      "id": "evaluation.king_safety",
      "kind": "evaluation_factor",
      "preferred_name": "King Safety Factor",
      "definition": "The relative vulnerability, shelter, escape resources, and attacking pressure around each king.",
