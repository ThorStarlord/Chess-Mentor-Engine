      "default_assertion_authority": "heuristic_assessment",
      "parent_ids": ["group.plans"]
    },
    {
      "id": "plan.activate_king",
      "kind": "plan",
      "preferred_name": "Activate the King",
      "definition": "Bring the king toward central, pawn, or entry-square duties when the simplified position makes active king play appropriate.",
